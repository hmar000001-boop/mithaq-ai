<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The separately installed companion must be query-visible for explicit
         cross-package bindService calls on Android 11+. Include release and
         debug IDs; no broad QUERY_ALL_PACKAGES permission is used. -->
    <queries>
        <package android:name="com.mithaq.network" />
        <package android:name="com.mithaq.network.debug" />
    </queries>
    <!-- AndroidX Core adds a legacy not-exported receiver permission for API < 33.
         Mithaq minSdk is 35, where ContextCompat uses the platform API 33+ overload.
         Remove both library nodes so neither APK requests an unused custom permission. -->
    <permission
        android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        tools:node="remove" />
    <uses-permission
        android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        tools:node="remove" />
    <!-- Required to bind to the companion service protected by this signature permission. -->
    <uses-permission android:name="com.mithaq.network.permission.BIND_COMPANION" />

    <application
        android:allowBackup="false"
        android:label="Mithaq"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Phase-0 proof service only. It is not the production inference service. -->
        <service
            android:name=".probe.IsolatedInferenceProbeService"
            android:exported="false"
            android:isolatedProcess="true"
            android:process=":inference_probe"
            android:stopWithTask="true" />
    </application>
</manifest>
